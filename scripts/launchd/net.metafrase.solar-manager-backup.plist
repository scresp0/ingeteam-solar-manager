<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Backup diario de InfluxDB (solar-manager) a la NAS por NFS — equivalente en macOS
  de scripts/systemd/solar-manager-backup.{service,timer}.

  LaunchAgent (no LaunchDaemon): corre en la sesión del usuario, igual que Docker
  Desktop, y el script monta el NFS sin sudo. Requiere sesión iniciada.

  Instalar / actualizar:
    cp scripts/launchd/net.metafrase.solar-manager-backup.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/net.metafrase.solar-manager-backup 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.metafrase.solar-manager-backup.plist
  Lanzar ahora:  launchctl kickstart gui/$(id -u)/net.metafrase.solar-manager-backup
  Estado:        launchctl print gui/$(id -u)/net.metafrase.solar-manager-backup
  Log:           ~/Library/Logs/solar-manager-backup.log

  StartCalendarInterval: si el Mac estaba DORMIDO a las 23:57 se ejecuta al
  despertar; si estaba APAGADO, esa noche se pierde (no hay Persistent=true).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.metafrase.solar-manager-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/scresp0/contenedores/solar-manager/scripts/backup_influxdb.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>57</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/scresp0/Library/Logs/solar-manager-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/scresp0/Library/Logs/solar-manager-backup.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
