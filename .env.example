# =============================================================================
# solar-manager — variables de entorno con credenciales e identificadores
# Copia este fichero como .env y rellena tus valores.
# El .env NUNCA se sube a git (está en .gitignore).
# Estas variables sobreescriben los valores equivalentes de config.yaml.
# =============================================================================

# Solcast
SOLCAST_API_KEY=
SOLCAST_RESOURCE_ID=

# Inversor Ingeteam
INVERTER_WEB_URL=
INVERTER_USERNAME=
INVERTER_PASSWORD=
INVERTER_MODBUS_HOST=

# Email (notificaciones)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# InfluxDB
INFLUXDB_PASSWORD=cambia-esta-password
INFLUXDB_TOKEN=cambia-este-token-por-uno-seguro
INFLUXDB_ORG=solar
INFLUXDB_BUCKET=solar-manager

# Serial del inversor (para el logger HTTP)
INVERTER_DEVICE_ID=

# Parámetros de carga (sobreescriben config.yaml)
# MIN_SOC_PCT=30
# MAX_SOC_PCT=100
# RISK_FACTOR=0.7
# SAFETY_MARGIN_KWH=1.0
# NIGHT_CONSUMPTION_KWH=3.5

# Email — direcciones (sobreescriben config.yaml)
# MAIL_FROM=solar-manager@tudominio.com
# MAIL_TO=tu@email.com
