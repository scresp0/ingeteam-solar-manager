# Copia este fichero como .env y rellena tus valores.
# El .env NUNCA se sube a git (está en .gitignore).
# Estas variables sobreescriben los valores equivalentes de config.yaml,
# lo que es útil para pasar secretos en entornos Docker/CI sin tocar el YAML.

# Solcast
SOLCAST_API_KEY=

# Inversor
INVERTER_PASSWORD=

# Override de dry_run desde entorno (útil para CI)
# DRY_RUN=true
